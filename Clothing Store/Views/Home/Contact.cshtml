@{
    ViewData["Title"] = "Կապ Մեզ Հետ";
}

<div class="container my-5">
    <h2 class="text-center mb-4">Կապ Մեզ Հետ</h2>
    <div class="row">
        <!-- Խանութի տվյալները -->
        <div class="col-md-6 mb-4">
            <div class="p-4 bg-light rounded shadow-sm">
                <h4>Elegance Boutique</h4>
                <p class="text-muted">Մենք սիրով սպասում ենք Ձեզ մեր սրահում:</p>
                <ul class="list-unstyled">
                    <li class="mb-2">📍 <strong>Հասցե:</strong> ք. Երևան, Երվանդ Քոչար 17/2</li>
                    <li class="mb-2">📞 <strong>Հեռախոս:</strong> +374 99 000 000</li>
                    <li class="mb-2">✉️ <strong>Էլ. հասցե:</strong> info@elegance.am</li>
                    <li class="mb-2">🕒 <strong>Աշխատանքային ժամեր:</strong> Երկ - Շբթ (10:00 - 20:00)</li>
                </ul>
            </div>
        </div>

        <!-- Հետադարձ կապի ֆորմա -->
        <div class="col-md-6">
            <form class="p-4 border rounded shadow-sm">
                <div class="mb-3">
                    <label class="form-label">Անուն Ազգանուն</label>
                    <input type="text" class="form-control" placeholder="Ձեր անունը">
                </div>
                <div class="mb-3">
                    <label class="form-label">Էլ. Հասցե</label>
                    <input type="email" class="form-control" placeholder="name@example.com">
                </div>
                <div class="mb-3">
                    <label class="form-label">Նամակ</label>
                    <textarea class="form-control" rows="4" placeholder="Ձեր հարցը կամ պատվերը..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100">Ուղարկել</button>
            </form>
        </div>
    </div>
</div>